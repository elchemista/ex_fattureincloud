{
  "source": "https://developers.fattureincloud.it/docs/basics/limits-and-quotas/",
  "reason": "Get API Usage was documented on 2026-10-13 and is not yet in the pinned OpenAPI 2.1.8 specification.",
  "paths": {
    "/c/{company_id}/info/api_usage": {
      "parameters": [
        {
          "$ref": "#/components/parameters/company_id"
        }
      ],
      "get": {
        "operationId": "getApiUsage",
        "tags": [
          "Companies"
        ],
        "summary": "Get API Usage",
        "description": "Returns current API usage and quotas. This request consumes quota.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Current hourly and monthly usage, as documented in the linked official guide.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "app_id": {
                          "type": "integer",
                          "nullable": true,
                          "description": "App ID; null for shared private-app quotas."
                        },
                        "hourly": {
                          "type": "object",
                          "properties": {
                            "default_limit": {
                              "type": "integer",
                              "description": "Standard API quota for this window."
                            },
                            "limit": {
                              "type": "integer",
                              "description": "Applied limit, including any custom quota."
                            },
                            "custom_limit": {
                              "type": "integer",
                              "nullable": true,
                              "description": "Custom quota, or null when not set."
                            },
                            "usage": {
                              "type": "integer",
                              "description": "Requests consumed, including the current usage request."
                            },
                            "remaining": {
                              "type": "integer",
                              "description": "Requests remaining in the current window."
                            },
                            "date": {
                              "type": "string",
                              "description": "Start of the quota window, in the provider format."
                            }
                          }
                        },
                        "monthly": {
                          "type": "object",
                          "properties": {
                            "default_limit": {
                              "type": "integer",
                              "description": "Standard API quota for this window."
                            },
                            "limit": {
                              "type": "integer",
                              "description": "Applied limit, including any custom quota."
                            },
                            "custom_limit": {
                              "type": "integer",
                              "nullable": true,
                              "description": "Custom quota, or null when not set."
                            },
                            "usage": {
                              "type": "integer",
                              "description": "Requests consumed, including the current usage request."
                            },
                            "remaining": {
                              "type": "integer",
                              "description": "Requests remaining in the current window."
                            },
                            "date": {
                              "type": "string",
                              "description": "Start of the quota window, in the provider format."
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "examples": {
                  "official-guide": {
                    "value": {
                      "data": {
                        "app_id": 123,
                        "hourly": {
                          "default_limit": 1000,
                          "limit": 1000,
                          "custom_limit": null,
                          "usage": 160,
                          "remaining": 840,
                          "date": "2026-10-13 15:00:00"
                        },
                        "monthly": {
                          "default_limit": 40000,
                          "limit": 40000,
                          "custom_limit": null,
                          "usage": 12570,
                          "remaining": 27430,
                          "date": "2026-10-01"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
